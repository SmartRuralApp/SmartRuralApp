# Smart Gram Panchayat Environment Variables Config Example

# Express port to listen to
PORT=3000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# Path to write/read the SQLite database file
DATABASE_PATH=data/panchayat.db

# Custom path or executable name for Python (e.g. 'python', 'python3', 'py', or custom path)
# If left empty, the server automatically detects and probes your system's python executable.
PYTHON_EXECUTABLE=

# Session encryption secret key
SESSION_SECRET=panchayat-secret-key-2026-prod

# SMS API keys and config (FAST2SMS)
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
