<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 Internal Server Error - Smart Gram Panchayat</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <div class="success-page">
    <div class="success-card" style="border-top: 5px solid #d32f2f;">
      <div class="success-icon" style="background: #ffebee; color: #d32f2f;">
        <i class="fas fa-server"></i>
      </div>
      <h1 class="success-title" style="color: #d32f2f;">500 Server Error</h1>
      <p class="success-message">An unexpected error occurred on the server. Please try again later or contact the administrator.</p>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="success-details" style="text-align: left; background: #fafafa; padding: 15px; border-radius: 4px; border: 1px dashed #ccc;">
          <strong style="color: #c62828;">Error Log:</strong>
          <pre style="margin: 5px 0 0 0; white-space: pre-wrap; font-family: monospace; font-size: 0.85rem;"><%= error %></pre>
        </div>
      <% } %>
      
      <div class="mt-4">
        <a href="/" class="btn btn-primary" style="background: #1976d2;">
          <i class="fas fa-home"></i> Back to Home
        </a>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
