{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/test"
    },
    {
      "source": "/((?!api/test).*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": [
        "sql-wasm.wasm",
        "panchayat.db",
        "data/panchayat.db",
        "views/**",
        "public/**",
        "models/**",
        "datasets/**",
        "ml/**",
        "ml-engine.js"
      ]
    }
  }
}
