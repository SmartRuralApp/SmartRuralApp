{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "sql-wasm.wasm",
        "wasm-binary.js",
        "seed-db-binary.js",
        "panchayat.db",
        "data/panchayat.db",
        "views/**",
        "public/**",
        "models/**",
        "datasets/**",
        "ml/**",
        "ml-engine.js"
      ]
    }
  }
}
