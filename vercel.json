{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "sql-wasm.wasm",
          "node_modules/sql.js/dist/sql-wasm.wasm",
          "panchayat.db",
          "data/panchayat.db",
          "views/**",
          "public/**",
          "models/**",
          "datasets/**",
          "ml/**",
          "ml-engine.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
